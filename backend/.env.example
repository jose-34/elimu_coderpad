PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://kemsap:kemsap@localhost:5432/kemsap_codelive

JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

CORS_ORIGIN=http://localhost:5173

# Public Jitsi (meet.jit.si) by default. Point at a self-hosted Jitsi domain in production.
JITSI_DOMAIN=meet.jit.si
